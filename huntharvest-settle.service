[Unit]
Description=HuntHarvest settle job - fold settled watches into events (one-shot)
After=network.target mysql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/huntorharvest
EnvironmentFile=/var/www/huntorharvest/.env
ExecStart=/var/www/huntorharvest/venv/bin/python3 settle_watch.py

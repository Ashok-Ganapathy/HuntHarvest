<!DOCTYPE html>
<html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>HuntorHarvest - Earnings Effect LIVE 1000</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}body{background:#0a1410;color:#c9d1d9;font-family:ui-monospace,Menlo,monospace;font-size:11px}
.header{display:flex;align-items:center;gap:12px;padding:10px 14px;background:#0d1a12;border-bottom:1px solid #1f3922;position:sticky;top:0;z-index:10;flex-wrap:wrap}
.logo{font-weight:900;color:#2ea043} .logo span{color:#f0883e}
.badge{background:#1f3922;border:1px solid #2ea043;color:#2ea043;padding:2px 8px;border-radius:10px;font-size:11px}
.search{margin-left:auto;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.search input{background:#0a1410;border:1px solid #30363d;color:#c9d1d9;padding:5px 8px;border-radius:4px;width:160px}
.main{display:flex;height:calc(100vh - 45px)}
.left{width:185px;background:#0d1a12;border-right:1px solid #1f3922;padding:8px;flex-shrink:0;overflow:auto}
.left .group{color:#7d8590;font-size:9px;margin:12px 0 4px;letter-spacing:1px}
.left .item{padding:6px 8px;border-radius:4px;cursor:pointer;display:flex;justify-content:space-between;font-size:11px}
.left .item.active{background:#1f3922;color:#f0883e;border-left:2px solid #f0883e}
.center{flex:1;overflow:auto;background:#0a1410}
.tabs{display:flex;gap:2px;padding:6px 10px;background:#0d1a12;border-bottom:1px solid #1f3922;flex-wrap:wrap}
.tab{padding:4px 10px;border-radius:4px;cursor:pointer;background:#161b22;border:1px solid #30363d;font-size:11px}
.tab.active{background:#1f3922;border-color:#f0883e;color:#f0883e}
table{width:100%;border-collapse:collapse;font-size:10.5px}
th{position:sticky;top:0;background:#0d1a12;z-index:5;padding:6px 5px;text-align:left;border-bottom:1px solid #30363d;cursor:pointer;white-space:nowrap;user-select:none}
th:hover{color:#f0883e;background:#1a2e1a} td{padding:4px 5px;border-bottom:1px solid #121a14;white-space:nowrap;max-width:180px;overflow:hidden;text-overflow:ellipsis}
tr:hover td{background:#162216}
.neg{color:#f85149} .pos{color:#2ea043} .warn{color:#d29922}
.buy{background:#f0883e;color:#000;border:0;padding:2px 7px;border-radius:3px;cursor:pointer;font-weight:700;font-size:10px}
.right{width:240px;background:#0d1a12;border-left:1px solid #1f3922;padding:10px;flex-shrink:0;overflow:auto}
.right h4{font-size:9px;color:#7d8590;margin:10px 0 4px;letter-spacing:1px}
.right .box{background:#0a1410;border:1px solid #1f3922;padding:6px;border-radius:4px;margin-bottom:8px;font-size:11px}
input[type=range]{width:100%}
</style></head><body>
<div class="header"><div class="logo">Hunt <span>or</span> HARVEST</div><div class="badge" id="status">LIVE • /api/drops loading...</div><div class="search"><span id="count">0 / 0</span><input id="q" placeholder="Ticker..."><span>Min Prob</span><input type="range" id="prob" min="0.5" max="0.95" step="0.05" value="0.5" style="width:80px"><span id="probv">0.50</span></div></div>
<div class="main"><div class="left"><div class="group">EARNINGS</div><div class="item active">📊 Earnings Effect</div><div class="item">✓ Qualified <span id="qcnt">0</span></div><div class="group">TRADE</div><div class="item">💼 Positions</div><div class="item">📈 Backtest</div><div class="group">SYSTEM</div><div class="item">🔔 Alerts</div><div class="item">⚙️ Admin</div><div style="margin-top:12px;padding:6px;background:#0a1410;border:1px dashed #2ea043;border-radius:4px;font-size:9px">✅ Cleaned build - 6 nav only<br>✅ All cols sortable<br>✅ 1000 rows live<br>API: 18 cols exact match</div></div>
<div class="center"><div class="tabs"><div class="tab">Overview</div><div class="tab active" id="tab-count">Earnings Effect (0)</div><div class="tab">Qualified</div><div class="tab">Backtest</div><div class="tab">Admin</div></div><div style="overflow:auto;max-height:calc(100vh - 90px)"><table id="tbl"><thead><tr>
<th data-k="ticker">Ticker</th><th data-k="date">Date</th><th data-k="drop_pct">Drop%</th><th data-k="open">Open</th><th data-k="high">High</th><th data-k="low">Low</th><th data-k="close">Close</th><th data-k="pre_close">PreCls</th><th data-k="post_low">PostLow</th><th data-k="vol_ratio">Volx</th><th data-k="market_cap">MCap</th><th data-k="bounce_prob">Bounce</th><th data-k="mom_3m">Mom3M</th><th data-k="surprise">Surp</th><th data-k="pnl_10d">PnL10D</th><th data-k="cluster">Clust</th><th data-k="sector">Sector</th><th data-k="qualified">Q</th><th>BUY</th></tr></thead><tbody id="body"></tbody></table></div></div>
<div class="right"><h4>FILTERS (5)</h4><div class="box"><div>Bounce >= <span id="fprob">0.50</span></div><input type="range" id="fprobR" min="0.5" max="0.95" step="0.05" value="0.5"></div>
<div class="box"><div>Drop% Range</div>Min <input type="number" id="dropMin" value="-35" style="width:55px"> Max <input type="number" id="dropMax" value="-8" style="width:55px"></div>
<div class="box"><div>Vol Ratio</div><label><input type="checkbox" class="vol" value="low" checked> Low &lt;1</label><br><label><input type="checkbox" class="vol" value="med" checked> Med 1-3</label><br><label><input type="checkbox" class="vol" value="high" checked> High &gt;3</label></div>
<div class="box"><div>Mom 3M</div><label><input type="checkbox" class="mom" value="neg" checked> Neg</label><br><label><input type="checkbox" class="mom" value="pos" checked> Pos</label><br><label><input type="checkbox" class="mom" value="strong" checked> Strong &gt;50%</label></div>
<div class="box"><label><input type="checkbox" id="qualOnly"> Qualified only</label></div>
<div class="box"><button id="refresh" class="buy" style="width:100%">🔄 Refresh</button><div id="apiInfo" style="margin-top:6px;font-size:9px;color:#7d8590"></div><div id="dateInfo" style="margin-top:4px;font-size:9px;color:#f0883e"></div></div></div></div>
<script>
let raw=[], sortK='date', sortDir='desc';
const fmtMcap=v=>{if(!v)return'-';if(v>=1e9)return'$'+(v/1e9).toFixed(2)+'B';if(v>=1e6)return'$'+(v/1e6).toFixed(0)+'M';return'$'+(v|0)};
async function load(){try{const r=await fetch('/api/drops');const j=await r.json();raw=j.rows||j;document.getElementById('status').textContent='LIVE: '+(j.count||raw.length)+' rows';document.getElementById('apiInfo').textContent='API OK: '+(j.count||raw.length)+' rows, cols aligned to API';if(raw.length){const dates=raw.map(x=>x.date).sort();document.getElementById('dateInfo').textContent='Range: '+dates[0]+' → '+dates[dates.length-1]+' (DB stale if ends 2025-07-29)';} }catch(e){document.getElementById('status').textContent='API failed: '+e;raw=[];}render();}
function getFiltered(){const q=document.getElementById('q').value.toUpperCase();const minP=parseFloat(document.getElementById('fprobR').value);const dMin=parseFloat(document.getElementById('dropMin').value);const dMax=parseFloat(document.getElementById('dropMax').value);const volChecks=[...document.querySelectorAll('.vol:checked')].map(x=>x.value);const momChecks=[...document.querySelectorAll('.mom:checked')].map(x=>x.value);const qualOnly=document.getElementById('qualOnly').checked;let f=raw.filter(r=>{if(q&&!r.ticker.includes(q))return false;if((r.bounce_prob||0)<minP)return false;const dp=r.drop_pct;if(dp<dMin||dp>dMax)return false;if(qualOnly&&r.qualified!=1)return false;let vc='low';if(r.vol_ratio>=3)vc='high';else if(r.vol_ratio>=1)vc='med';if(!volChecks.includes(vc))return false;let mc='neg';if(r.mom_3m>50)mc='strong';else if(r.mom_3m>=0)mc='pos';if(!momChecks.includes(mc))return false;return true});f.sort((a,b)=>{let av=a[sortK],bv=b[sortK];if(sortK==='date'){av=new Date(a.date);bv=new Date(b.date);}if(av==null)av=-1e18;if(bv==null)bv=-1e18;if(typeof av==='string'){av=av.toLowerCase();bv=bv.toLowerCase();}let cmp=0;if(av<bv)cmp=-1;else if(av>bv)cmp=1;return sortDir==='asc'?cmp:-cmp;});return f;}
function render(){const data=getFiltered();document.getElementById('count').textContent=data.length+' / '+raw.length;document.getElementById('tab-count').textContent='Earnings Effect ('+raw.length+')';document.getElementById('qcnt').textContent=raw.filter(r=>r.qualified==1).length;const tb=document.getElementById('body');tb.innerHTML='';data.forEach((r,i)=>{const tr=document.createElement('tr');const dropCls=r.drop_pct<0?'neg':'';const momCls=r.mom_3m>=0?'pos':'neg';const pnlCls=r.pnl_10d>=0?'warn':'neg';tr.innerHTML=`<td><b>${r.ticker}</b></td><td>${r.date}</td><td class="${dropCls}">${r.drop_pct.toFixed(2)}%</td><td>${r.open?.toFixed(2)}</td><td>${r.high?.toFixed(2)}</td><td>${r.low?.toFixed(2)}</td><td>${r.close?.toFixed(2)}</td><td>${r.pre_close?.toFixed(2)}</td><td>${r.post_low?.toFixed(2)}</td><td>${r.vol_ratio?.toFixed(2)}x</td><td>${fmtMcap(r.market_cap)}</td><td><div style="display:flex;gap:3px;align-items:center"><div style="width:24px;height:4px;background:#1f3922"><div style="width:${(r.bounce_prob*100).toFixed(0)}%;height:100%;background:#2ea043"></div></div>${r.bounce_prob?.toFixed(3)}</div></td><td class="${momCls}">${r.mom_3m>0?'+':''}${r.mom_3m?.toFixed(1)}%</td><td>${r.surprise?.toFixed(1)}%</td><td class="${pnlCls}">${r.pnl_10d>0?'+':''}${r.pnl_10d?.toFixed(2)}%</td><td>C${r.cluster}</td><td title="${r.sector}">${(r.sector||'').slice(0,20)}</td><td>${r.qualified?'✓':''}</td><td><button class="buy" onclick="alert('${r.ticker} BUY')">BUY</button></td>`;tb.appendChild(tr);});}
document.querySelectorAll('th[data-k]').forEach(th=>{th.onclick=()=>{const k=th.dataset.k;if(sortK===k)sortDir=sortDir==='asc'?'desc':'asc';else{sortK=k;sortDir='desc';}render();}});
document.getElementById('q').oninput=render;document.getElementById('fprobR').oninput=e=>{document.getElementById('fprob').textContent=e.target.value;document.getElementById('probv').textContent=e.target.value;render();};document.getElementById('prob').oninput=e=>{document.getElementById('probv').textContent=e.target.value;document.getElementById('fprobR').value=e.target.value;document.getElementById('fprob').textContent=e.target.value;render();};document.getElementById('dropMin').oninput=render;document.getElementById('dropMax').oninput=render;document.querySelectorAll('.vol,.mom').forEach(x=>x.onchange=render);document.getElementById('qualOnly').onchange=render;document.getElementById('refresh').onclick=load;
load();
</script></body></html>

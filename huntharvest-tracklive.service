[Unit]
Description=HuntHarvest daily forward-tracker for live-originated events (one-shot)
After=network.target mysql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/huntorharvest
EnvironmentFile=/var/www/huntorharvest/.env
ExecStart=/var/www/huntorharvest/venv/bin/python3 track_live_events.py

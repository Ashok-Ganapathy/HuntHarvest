[Unit]
Description=HuntHarvest Phase 3 analysis backfill - re-check events crossing the settled window (one-shot)
After=network.target mysql.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/huntorharvest
EnvironmentFile=/var/www/huntorharvest/.env
ExecStart=/var/www/huntorharvest/venv/bin/python3 backfill_event_analysis.py
